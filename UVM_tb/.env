# --- Environment Variables for Vivado Migration ---

# Vivado installation path
VIVADO_HOME=/tools/Xilinx/Vivado/2022.1
XILINX_VIVADO=/tools/Xilinx/Vivado/2022.1

# Path to Vivado settings script (you can source this before running make)
# source /tools/Xilinx/Vivado/2021.1/settings64.sh

# Spike installation path
SPIKE_HOME=/home/rafi/tools/spike
SPIKE_CMD=/home/rafi/tools/spike/bin/spike

# RISC-V toolchain prefix
# Using xPack riscv-none-elf-gcc 15.2.0 (installed at ~/tools/xpack-riscv-none-elf-gcc-15.2.0-1)
# because the apt-packaged gcc-riscv64-unknown-elf (10.2.0) doesn't support -march=rv32im_zicsr
RISCV_PREFIX=riscv-none-elf

# Default test configuration
DEFAULT_TEST_NAME=riscv_arithmetic_basic_test
TARGET_ISA=rv32im
TARGET_ARCH=rv32im_zicsr
TARGET_ABI=ilp32
