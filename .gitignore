# ============================================================================
# .gitignore  -  commit SOURCE only; ignore everything tools regenerate.
#
# KEEP (source):  fpga/rtl/*.sv,*.v   fpga/work/rv32i.tcl   UVM_tb/**/*.sv,*.tcl,
#                 *.cmd,*.py,*.sh,*.S,*.ld,*.f,*.md   FW/*.c,*.h   GCC/*   README*
# IGNORE (generated): the Vivado project, Vitis workspace, DCPs, sim outputs.
# ============================================================================

# ---- Vivado/Vitis work area ----
# Everything under fpga/work/ is regenerated by rv32i.tcl, EXCEPT the script
# itself. This one rule covers RV32I_FPGA.*, old_vivado/, vitis/, .Xil, *.xsa,
# and any future generated junk in that folder.
fpga/work/*
!fpga/work/rv32i.tcl
!fpga/work/add_riscv_axi_lite_core.tcl
*.xsa

# also ignore any Vitis workspace / generated dirs wherever they appear
vitis/
**/*_bsp/

# ---- Synthesized checkpoints & generated block-design metadata ----
# DCPs are build output (synthesized netlists) - never commit them.
*.dcp
fpga/dcp/
fpga/bd/

# ---- Vivado / xsim run junk ----
.Xil/
xsim.dir/
*.jou
*.pb
*.wdb
*.wcfg
*.str
*.vcd
usage_statistics_webtalk.*
vivado*.backup.*
webtalk*.jou
webtalk*.log

# ---- UVM (my_uvm) generated project ----
UVM_tb/my_uvm/proj/

# ---- Spike lockstep generated artifacts ----
UVM_tb/spike_lockstep/program.hex
UVM_tb/spike_lockstep/spike.log
UVM_tb/spike_lockstep/rtl_trace.log
UVM_tb/spike_lockstep/sw/*.elf
UVM_tb/spike_lockstep/sw/*.bin

# ---- tb/ Icarus Verilog generated outputs (source kept: *.sv,*.hex,run_sim.*) ----
tb/riscv_sim
tb/riscv_sim_check
tb/*_sim
tb/axi_compile_check

# ---- Local reference downloads and generated upstream documentation ----
/riscv-core-dv-uvm-main/
/riscv-core-dv-uvm-main.zip
/riscv-dv-7e54b678ab7499040336255550cdbd99ae887431.zip
/UVM_tb/RISC-V/riscv-dv/docs/build/

# ---- Verilator (future regression flow) ----
obj_dir/
obj_dir_wsl/

# ---- GCC bare-metal build outputs (rebuild with: cd GCC && make) ----
#  Source kept: main.c, crt0.s, linker.ld, Makefile, emit_riscv_header.py, shared_mem.h
GCC/*.hex
GCC/*.map
GCC/rv32i_program_image.h
# the generated image header is also copied next to the Vitis loader
FW/rv32i_program_image.h

# ---- compiled / build outputs ----
GCC/build/
*.o
*.elf
*.bin

# ---- logs (Vivado, xsim, spike, etc.) ----
*.log

# ---- Python ----
__pycache__/
*.pyc

# ---- editor / OS ----
*.swp
*~
.DS_Store
